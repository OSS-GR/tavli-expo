{
  "name": "tavli",
  "private": true,
  "description": "Tavlaki: a Greek backgammon app for iOS and Android.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "start": "pnpm --filter @tavli/mobile start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:changed": "pnpm -r --filter '...[origin/main]' --filter '!tavli' --filter '!@tavli/mobile' test && pnpm --filter @tavli/mobile exec jest --changedSince=origin/main --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
