# Cloudflare headers (#332): Workers static assets, also Pages and Netlify.
# iOS reads this file for universal links. It must be JSON, over HTTPS,
# with no redirect. The file has no extension, so name the type here.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Invite pages hold a code: keep them out of search engines.
/i/*
  X-Robots-Tag: noindex
