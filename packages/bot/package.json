{
  "name": "@tavli/bot",
  "version": "0.0.0",
  "private": true,
  "description": "Bot players for tavli. Pure TypeScript. Depends only on the engine and the contracts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "node --import ./scripts/register-ts.mjs ./scripts/simulate.ts",
    "tune": "node --import ./scripts/register-ts.mjs ./scripts/tune.ts",
    "train": "node --import ./scripts/register-ts.mjs ./scripts/train.ts",
    "golden:asodio": "node --import ./scripts/register-ts.mjs ./scripts/asodio-golden.ts",
    "bench:asodio": "node --import ./scripts/register-ts.mjs ./scripts/bench-asodio.ts"
  },
  "dependencies": {
    "@tavli/contracts": "workspace:*",
    "@tavli/engine": "workspace:*"
  }
}
