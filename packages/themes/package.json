{
  "name": "@tavli/themes",
  "version": "0.0.0",
  "private": true,
  "description": "Board themes (skins): a theme.json manifest plus images. Pure TypeScript and assets.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./walnut-kafeneio/*": "./walnut-kafeneio/*",
    "./olive-inlay/*": "./olive-inlay/*",
    "./kafeneio-night/*": "./kafeneio-night/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:assets": "node tools/build-assets.mjs",
    "preview": "node tools/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
