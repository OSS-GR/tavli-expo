{
  "expo": {
    "name": "Tavlaki",
    "slug": "tavlaki",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "backgroundColor": "#3B2A1D",
    "scheme": "tavlaki",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tavlaki",
      "icon": {
        "light": "./assets/icon/icon.png",
        "dark": "./assets/icon/icon-ios-dark.png",
        "tinted": "./assets/icon/icon-ios-tinted.png"
      }
    },
    "android": {
      "package": "com.tavlaki",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-foreground.png",
        "backgroundImage": "./assets/icon/android-background.png",
        "monochromeImage": "./assets/icon/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B2A1D",
          "image": "./assets/icon/splash.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#120C07",
            "image": "./assets/icon/splash-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["el", "en"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
